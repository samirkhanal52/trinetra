# Set to "local" to use local MinIO instead of AWS S3
TRINETRA_ENV="local"

# --- AWS S3 Configuration (used if TRINETRA_ENV is "production") ---
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="YOUR_ACCESS_KEY"
AWS_SECRET_ACCESS_KEY="YOUR_SECRET_KEY"

# --- Local MinIO Configuration (used if TRINETRA_ENV is "local") ---
# This should match the docker-compose.yml file
MINIO_ENDPOINT_URL="http://127.0.0.1:9001"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"

S3_BUCKET_NAME="trinetra-bucket"
S3_PREFIX="user-activity"

# Get your OpenAI API Key from https://platform.openai.com/
OPENAI_API_KEY="your-openai-api-key-here"

# --- LangSmith Observability ---
# Get your LangSmith API Key from https://smith.langchain.com/
# This will enable tracing and debugging of your LLM calls.
LANGCHAIN_TRACING_V2="true"
LANGCHAIN_API_KEY="your-langchain-api-key-here"
LANGCHAIN_PROJECT="Trinetra"
